FROM python:3.12-slim

WORKDIR /app

# Install uv
RUN pip install --no-cache-dir uv

# Copy your code and chroma_db
COPY . .

# Explicitly install ONLY the required production packages directly to the system
RUN uv pip install --system streamlit langchain langchain-openai langchain-chroma python-dotenv

EXPOSE 8501

CMD ["streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0"]